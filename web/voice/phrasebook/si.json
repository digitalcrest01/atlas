{
  "book": "si",
  "name": "Sinhala",
  "native": "සිංහල",
  "phrases": {
    "hello": {
      "text": "ආයුබෝවන්",
      "roman": "āyubōvan",
      "say": "AA-yu-boh-wan"
    },
    "good_morning": {
      "text": "සුබ උදෑසනක්",
      "roman": "suba udǣsanak",
      "say": "SU-ba u-DAA-sa-nak"
    },
    "good_evening": {
      "text": "සුබ සන්ධ්‍යාවක්",
      "roman": "suba sandhyāvak",
      "say": "SU-ba san-DHYAA-wak"
    },
    "goodbye": {
      "text": "ගිහින් එන්නම්",
      "roman": "gihin ennam",
      "say": "gi-HIN EN-nam"
    },
    "how_are_you": {
